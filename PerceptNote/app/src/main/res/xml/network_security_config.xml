<?xml version="1.0" encoding="utf-8"?>
<!-- 📄 app/src/main/res/xml/network_security_config.xml -->
<!-- Autorise uniquement HTTPS — aucun cleartext HTTP en production -->
<network-security-config>
    <!-- En développement uniquement — supprimer en release -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- Production : HTTPS uniquement -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Anthropic API — HTTPS forcé -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.anthropic.com</domain>
    </domain-config>

    <!-- Firebase — HTTPS forcé -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">firebaseapp.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">firebase.google.com</domain>
    </domain-config>
</network-security-config>
